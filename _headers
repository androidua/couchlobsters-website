/*
  # Force HTTPS for 1 year — browsers will refuse HTTP connections after first visit
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # Prevent clickjacking — block site from being embedded in iframes
  X-Frame-Options: DENY

  # Stop browsers from guessing content types (MIME sniffing)
  X-Content-Type-Options: nosniff

  # Control referrer information sent to external sites
  Referrer-Policy: strict-origin-when-cross-origin

  # Restrict browser features not needed by this site
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

  # Content Security Policy — allowlist only trusted sources
  # - Scripts: self + Cloudflare Insights (auto-injected by Cloudflare Pages)
  # - Styles: self + Google Fonts
  # - Fonts: Google Fonts CDN
  # - Images: self + podcast CDNs (Spotify, podcloud.fr) + data URIs
  # - Connections: self + Cloudflare Insights beacon reporting
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https://i.scdn.co https://uploads.podcloud.fr https://media.themoviedb.org https://image.tmdb.org; connect-src 'self' https://cloudflareinsights.com; frame-ancestors 'none'
